generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model User {
  id             String           @id @default(uuid(7))
  name           String
  email          String           @unique
  password       String?
  avatar         String?
  role           Role             @default(USER)
  status         UserStatus       @default(ACTIVE)
  gems           Int              @default(200)
  hasPlan        Boolean          @default(false)
  lastLoginAt    DateTime?
  gemTransaction GemTransaction[]
  devices        Device[]
  subscription   Subscription?
  userAvatars    UserAvatar[]
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("users")
}

model Subscription {
  id           String             @id @default(uuid(7))
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  revenuecatId String?
  entitlement  String             @default("mobile-apps-core-firebase Pro")
  status       SubscriptionStatus @default(ACTIVE)
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("subscriptions")
}

model Avatar {
  id          String       @id @default(uuid(7))
  name        String?
  imageUrl    String
  priceGems   Int          @default(0)
  isPremium   Boolean      @default(false)
  userAvatars UserAvatar[]
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("avatars")
}

model UserAvatar {
  id         String    @id @default(uuid(7))
  userId     String
  avatarId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     Avatar    @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  isEquipped Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())

  @@unique([userId, avatarId])
  @@map("user_avatars")
}

model GemTransaction {
  id        String    @id @default(uuid(7))
  amount    Int
  reason    String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  deletedBy String?

  @@map("gem_transactions")
}

model Device {
  id        String         @id @default(uuid(7))
  token     String         @unique
  platform  DevicePlatform
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("devices")
}